<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springtestdemo.mapper.THrEmpUserMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="org.example.springtestdemo.entity.User">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="age" property="age" jdbcType="INTEGER"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 通用列 -->
    <sql id="Base_Column_List">
       select id, name, password, age, email from test.sys_user
    </sql>

    <!-- 获取所有用户 -->
    <select id="listAllUsers" resultMap="BaseResultMap">
        <include refid="Base_Column_List"/>
    </select>

    <!-- 通过 id 获取用户 -->
    <select id="getUserById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT id, name, password, age, email
        FROM sys_user
        WHERE id = #{id}
    </select>

    <!-- 添加用户 -->
    <insert id="addUser" parameterType="org.example.springtestdemo.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO test.sys_user (
            name,
            password,
            age,
            email
        ) VALUES (
            #{username},
            #{password},
            #{age},
            #{email}
        )
    </insert>

</mapper>
